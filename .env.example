# Optional browser push-notification configuration.
# Leave blank until a push subscription service has been connected.
VITE_WEB_PUSH_VAPID_PUBLIC_KEY=
VITE_WEB_PUSH_SUBSCRIBE_URL=

# Optional bridge to Hotel Ping (hotelping.co.uk), the separate app the heads
# of department use. When both are set, a message sent to a department here
# also delivers once to that department's head in Hotel Ping. Leave blank to
# disable the bridge entirely - it is a silent no-op without a key.
HOTEL_PING_API_KEY=
HOTEL_PING_URL=https://hotelping.co.uk
