{
  "name": "freedom-services-dashboard",
  "main": "dist/server/index.js",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": ["nodejs_compat"],
  "no_bundle": true,
  "rules": [{ "type": "ESModule", "globs": ["**/*.js", "**/*.mjs"] }],
  "assets": { "directory": "dist/client" },
  "d1_databases": [
    { "binding": "DB", "database_name": "noir-house-db", "database_id": "e20a018c-4228-4343-856f-9c80bf3cc8dd" }
  ],
  "r2_buckets": [
    { "binding": "FILES", "bucket_name": "noir-house-files" }
  ],
  "observability": { "enabled": true }
}
